# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Dedup review artifacts (generated by scripts/find-duplicates.js at run time)
scripts/dedup-output/

# Offline USDA/OFF bulk data artifacts (multi-MB, gitignored per README.md
# provenance record — see scripts/data/README.md)
scripts/data/*
!scripts/data/README.md
# usda-seed.json is the small (~500-row) committed seed-build output
# (03-04-PLAN.md), not a multi-MB bulk artifact — tracked like README.md.
!scripts/data/usda-seed.json

# Seed pipeline output artifacts (generated by scripts/build-usda-seed.js) —
# catalog-comparison.md is a committed decision artifact (03-03-PLAN.md
# Task 2); other generated files (e.g. section-store-ids.json) are not.
scripts/seed-output/*
!scripts/seed-output/catalog-comparison.md

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env.local
