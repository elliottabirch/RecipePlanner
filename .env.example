# PocketBase prod credentials for local data scripts (apply-recipe-notes.mjs, etc.)
# Copy to `.env` and fill in. `.env` is gitignored — never commit real creds.
#
# Run a script with these loaded:  node --env-file=.env apply-recipe-notes.mjs

# PocketBase superuser (admin) login — the _superusers account for prod.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Prod PocketBase URL. Optional — defaults to http://192.168.50.95:8090 if unset.
PB_URL=http://192.168.50.95:8090
